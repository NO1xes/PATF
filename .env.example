# Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- LLM Backend ---
# URL of the vLLM OpenAI-compatible server (or any OpenAI-compatible endpoint)
VLLM_BASE_URL=http://127.0.0.1:8000/v1

# API key for the LLM backend (use "dummy" for local vLLM with no auth)
VLLM_API_KEY=dummy

# --- AgentProf ---
# Directory where profiling run outputs are written
AGENTPROF_PROFILE_DIR=./profiles

# Log level: DEBUG / INFO / WARNING
AGENTPROF_LOG_LEVEL=INFO

# --- HuggingFace (China mainland mirror) ---
# Uncomment if on a machine in China mainland
# HF_ENDPOINT=https://hf-mirror.com

# HuggingFace model cache directory (set to a large disk on GPU servers)
# HF_HOME=/data/hf_cache

# --- Machine config ---
# Which machine config to load (filename without .yaml, under configs/machines/)
AGENTPROF_MACHINE=local_pc_win11
