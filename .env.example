# Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- LLM Backend ---
# URL of the vLLM OpenAI-compatible server (or any OpenAI-compatible endpoint)
VLLM_BASE_URL=http://127.0.0.1:8000/v1

# API key for the LLM backend (use "dummy" for local vLLM with no auth)
VLLM_API_KEY=dummy

# Model name served by vLLM
VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# --- vLLM startup (GPU servers only) ---
# Path to Python binary in the vllm conda env; used by scripts/start_vllm.sh
# VLLM_PYTHON=/path/to/envs/vllm/bin/python

# --- AgentProf ---
# Directory where profiling run outputs are written
AGENTPROF_PROFILE_DIR=./profiles

# Log level: DEBUG / INFO / WARNING
AGENTPROF_LOG_LEVEL=INFO

# Which machine config to load (filename without .yaml, under configs/machines/)
AGENTPROF_MACHINE=local_pc_win11

# Working directory root (all output must stay here on shared servers)
# AGENTPROF_WORK_DIR=/your/workspace/path

# --- HuggingFace ---
# Uncomment if on a machine in China mainland
# HF_ENDPOINT=https://hf-mirror.com

# HuggingFace model cache directory (set to a large disk on GPU servers)
# HF_HOME=/path/to/cache/huggingface

# --- GitHub PAT (shared servers only) ---
# Personal Access Token for HTTPS git push/pull.
# Generate at: GitHub → Settings → Developer settings → Personal access tokens
# Grant: Contents: Read and Write on the AgentProf repo.
# GitHub username is required so scripts never place the PAT in remote URLs.
# GITHUB_USER=
# GITHUB_PAT=
