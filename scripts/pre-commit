#!/usr/bin/env bash
# Git pre-commit hook: run fast unit tests before every commit.
# Install: bash scripts/install_hooks.sh
#
# Skips GPU/LLM tests (no vLLM needed).
# To bypass in an emergency: git commit --no-verify

set -euo pipefail

# Only run if Python files are being committed
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [[ -z "$STAGED" ]]; then
    exit 0
fi

echo "[pre-commit] Running fast unit tests..."
export VLLM_BASE_URL="http://localhost:8000/v1"
export VLLM_API_KEY="dummy"
export VLLM_MODEL="dummy"
export AGENTPROF_MACHINE="local_pc_win11"

# Run the core unit tests (no GPU, no LLM, ~5s)
if ! pytest tests/test_schema.py tests/test_storage.py tests/test_validator.py tests/test_analysis.py \
        -x -q --tb=short 2>&1; then
    echo "[pre-commit] FAILED — fix tests before committing. To bypass: git commit --no-verify"
    exit 1
fi

echo "[pre-commit] Tests passed."
