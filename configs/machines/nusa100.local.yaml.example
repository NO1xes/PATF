# Machine-Private Configuration Template: nusa100
# Copy this file to nusa100.local.yaml and fill in real paths.
# This file is checked in as a template — nusa100.local.yaml is gitignored.
#
# nusa100.local.yaml is loaded by scripts and tools at runtime for
# machine-specific paths (conda envs, model cache, workspace, ports).
# It supplements configs/machines/nusa100.yaml which holds hardware/role info.

machine_id: nusa100

paths:
  workspace: /your/workspace/path           # e.g. /disk2/username/projects/AgentProf
  conda_base: /your/conda/base              # e.g. /disk2/username/miniconda3
  agentprof_env: /your/envs/agentprof       # conda env with agentprof + langchain
  vllm_env: /your/envs/vllm                 # conda env with vllm installed
  vllm_python: /your/envs/vllm/bin/python   # Python binary; used by start_vllm.sh (VLLM_PYTHON)
  hf_home: /your/cache/huggingface          # HuggingFace cache dir (HF_HOME in .env)

network:
  vllm_port: 18796          # check with: ss -tlnp | grep 187
  vllm_base_url: http://localhost:18796/v1  # set in .env as VLLM_BASE_URL

git:
  # PAT is stored in .env as GITHUB_PAT — never write it here
  git_remote_user: your_github_username

# After filling in this file, also update .env with:
#   VLLM_PYTHON=/your/envs/vllm/bin/python
#   HF_HOME=/your/cache/huggingface
#   VLLM_BASE_URL=http://localhost:18796/v1
#   VLLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
#   AGENTPROF_MACHINE=nusa100
#   AGENTPROF_WORK_DIR=/your/workspace/path
#   GITHUB_PAT=your_pat_here
